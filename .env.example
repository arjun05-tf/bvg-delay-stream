# Copy to .env and adjust. docker compose reads .env automatically.

# ----- Database -----------------------------------------------------------
POSTGRES_DB=delays
POSTGRES_USER=delays
POSTGRES_PASSWORD=change-me-before-you-push-this-anywhere

# ----- Feed ---------------------------------------------------------------
# Public VBB GTFS-Realtime feed. No key, CC BY 4.0, attribute
# "VBB Verkehrsverbund Berlin-Brandenburg GmbH" wherever you show the data.
FEED_URL=https://production.gtfsrt.vbb.de/data
POLL_INTERVAL_SECONDS=30

# Berlin only. Set to an empty value to ingest all of Berlin and Brandenburg,
# which roughly doubles the volume and the memory the job needs.
STOP_ID_PREFIX=de:11000:

# GTFS Schedule export used for stop and route names.
GTFS_URL=https://unternehmen.vbb.de/gtfs

# ----- Windows and watermarks --------------------------------------------
WATERMARK_OUT_OF_ORDERNESS_S=300
ALLOWED_LATENESS_S=600
TUMBLING_WINDOW_S=3600
SLIDING_WINDOW_S=3600
SLIDING_SLIDE_S=300
# Above zero turns on source idleness. Liveness on a quiet night network, at
# the cost of the bit-identical replay guarantee. See docs/architecture.md.
SOURCE_IDLE_TIMEOUT_S=0

# ----- Job ----------------------------------------------------------------
JOB_PARALLELISM=2
CHECKPOINT_INTERVAL_S=30
CONSUMER_GROUP=delay-pipeline
STARTING_OFFSETS=committed
SINK_BATCH_SIZE=500

# ----- Load test ----------------------------------------------------------
SPEEDUP=10
LOOPS=1
